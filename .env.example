# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ── Supabase Storage (Phase 3 — Cloud Share) ──────────────────────────────────
# Required for cross-device QR Code video sharing.
# 1. Create a project at https://supabase.com
# 2. Create a Storage bucket named "photobooth-videos" (set to Public)
# 3. Copy your project URL and anon key below
# If these are not set, the app falls back to local IndexedDB sharing (same-device only).
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"

# ── Email (Resend) — Envoi automatique des vidéos ─────────────────────────────
# 1. Créer un compte sur https://resend.com (gratuit jusqu'à 3 000 emails/mois)
# 2. Créer une API Key dans Resend Dashboard → API Keys
# 3. Vérifier votre domaine d'envoi dans Resend → Domains
# 4. Ajouter ces variables dans Supabase Dashboard → Edge Functions → Secrets
#    (PAS dans ce fichier — elles sont utilisées côté serveur uniquement)
# RESEND_API_KEY="re_"
# FROM_EMAIL="noreply@yourdomain.com"
# FROM_NAME="Photobooth 360"
